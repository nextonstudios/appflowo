{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flowo",
  "version": "0.8.4",
  "identifier": "com.nexonstudios.flowo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "flowo",
        "width": 800,
        "height": 600,
        "backgroundColor": "#1A1F2E",
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://localhost:* http://localhost:* https://github.com https://objects.githubusercontent.com https://releases.githubusercontent.com; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [],
      "desktop": {
        "schemes": ["flowo"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QzE1RkU5NDk5MURCNjYKUldSbTI1Rko2Vi9CTlF5ZVFsaXorRnJCYy9Ub2pwdGZGblQ2dy9jeWR3VncyTHozTXFSSDFFdy8K",
      "endpoints": [
        "https://github.com/nextonstudios/appflowo/releases/latest/download/latest.json"
      ]
    }
  }
}